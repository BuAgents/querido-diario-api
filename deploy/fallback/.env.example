# Copy to .env (bin/setup.sh does this and fills the secrets). Never commit .env.

# Private-network / VPN address the API (8080) and file links (8333) bind to.
# Example: the server's Tailscale or WireGuard IP. Never 0.0.0.0.
QD_BIND_ADDR=127.0.0.1
# Base URL clients use to download gazette files (file_url / txt_url).
QD_PUBLIC_FILES_ENDPOINT=http://127.0.0.1:8333/queridodiariobucket/

# Secrets: generated by bin/setup.sh.
POSTGRES_PASSWORD=<generated>
STORAGE_ACCESS_KEY=<generated>
STORAGE_ACCESS_SECRET=<generated>
SCRAPER_API_KEY=<generated>

# Where backups land (pg_dump files and OpenSearch snapshots).
QD_BACKUP_DIR=/srv/qd-fallback/backups

# Sizing. Defaults fit the recommended scoped option on an 8 GB host.
OPENSEARCH_HEAP=2g
OPENSEARCH_MEM=4g
POSTGRES_MEM=1g
STORAGE_MEM=1g
TIKA_MEM=2g
TIKA_CPUS=2
API_MEM=512m
SPIDERS_MEM=1g
PROCESSING_MEM=3g
PROCESSING_MEM_BYTES=3221225472

# How many days back the daily crawl re-checks (catches late publications).
QD_DAILY_LOOKBACK_DAYS=7

# Pinned upstream revisions and image versions (see README "Patch plan").
QD_SPIDERS_REF=c865658114970927df95ce3baa7ae99e833a2ab4
QD_PROCESSING_REF=c3069787ef4c5c3b5a7469d2d531f3f871b4aa7a
OPENSEARCH_VERSION=2.19.6
POSTGRES_VERSION=17
SEAWEEDFS_VERSION=4.48
TIKA_VERSION=3.3.1.0
